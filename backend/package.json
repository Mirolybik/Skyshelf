{
  "name": "skyshelf-backend",
  "version": "1.0.0",
  "description": "SkyShelf — защищённое облако для учебных команд. Backend на Node.js (переписано с Java Spring Boot).",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/db/migrate-cli.js up",
    "migrate:status": "node src/db/migrate-cli.js status",
    "seed": "node scripts/seed-demo.js",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test": "node --test test/"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "argon2": "^0.40.3",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "pino-pretty": "^11.2.1"
  }
}
